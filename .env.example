# 复制为 .env 后填写。.env 不要提交。

# ---- Tutor 调用图谱 API ----
GRAPH_BASE_URL=http://127.0.0.1:8000/api/v1
GRAPH_TIMEOUT_SECONDS=20
GRAPH_FRONTEND_URL=http://127.0.0.1:5173

# ---- Neo4j / 图谱 FastAPI ----
APP_NAME=算法学习知识图谱
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=False
RELOAD=False
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT_SECONDS=10
NEO4J_CONNECTION_ACQUISITION_TIMEOUT_SECONDS=30
NEO4J_MAX_CONNECTION_LIFETIME_SECONDS=3600
NEO4J_MAX_TRANSACTION_RETRY_TIME_SECONDS=15
NEO4J_QUERY_TIMEOUT_SECONDS=30
NEO4J_FETCH_SIZE=1000
NEO4J_FULLTEXT_INDEX_NAME=content_search_fulltext
GRAPH_STATISTICS_CACHE_TTL_SECONDS=30
HOME_DATA_CACHE_TTL_SECONDS=60
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8600","http://127.0.0.1:8600"]
CORS_ALLOW_CREDENTIALS=False
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ---- LLM 主脑 ----
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# ---- 星火（分叉点 B，暂不填）----
SPARK_BASE_URL=
SPARK_MODEL=
SPARK_API_KEY=

# ---- 讯飞语音（ASR / TTS，与星火文本模型凭据分开）----
VOICE_ENABLED=false
VOICE_PROVIDER=xfyun
XFYUN_VOICE_APP_ID=
XFYUN_VOICE_API_KEY=
XFYUN_VOICE_API_SECRET=
XFYUN_ASR_ENDPOINT=wss://iat-api.xfyun.cn/v2/iat
XFYUN_TTS_ENDPOINT=wss://tts-api.xfyun.cn/v2/tts
XFYUN_TTS_VOICE=xiaoyan
VOICE_FFMPEG_PATH=
VOICE_MAX_AUDIO_BYTES=5242880
VOICE_MAX_AUDIO_SECONDS=60
VOICE_TTS_MAX_CHARS=2000
VOICE_CONNECT_TIMEOUT_SECONDS=10
VOICE_REQUEST_TIMEOUT_SECONDS=45
VOICE_AUDIO_DECODE_TIMEOUT_SECONDS=15

# ---- 学习者模型 ----
MASTERY_THRESHOLD=0.7
PRUNE_THRESHOLD=0.5
UNIFIED_LEARNING_STATE=true
