        {
          "name": "name",
          "type": "String",
          "required": true,
          "unique": true,
          "description": "知识点名称"
        },
        {
          "name": "description",
          "type": "String",
          "required": false,
          "description": "知识点描述"
        },
        {
          "name": "difficulty",
          "type": "String",
          "required": false,
          "enum": ["入门", "基础", "进阶", "高级", "专家"],
          "description": "掌握难度"
        },
        {
          "name": "importance",
          "type": "Float",
          "required": false,
          "range": [0, 1],
          "default": 0.5,
          "description": "重要程度 0-1"
        },
        {
          "name": "learning_time",
          "type": "Integer",
