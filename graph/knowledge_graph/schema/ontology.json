      "to": "KnowledgePoint",
      "direction": "OUTGOING",
      "properties": {
        "strength": {
          "type": "String",
          "enum": ["强", "中", "弱"],
          "description": "依赖强度"
        }
      }
    },
    {
      "name": "PART_OF",
      "label": "包含",
      "description": "知识点包含关系",
      "from": "KnowledgePoint",
      "to": "KnowledgePoint",
      "direction": "OUTGOING"
    },
    {
      "name": "BASED_ON",
      "label": "基于",
      "description": "算法基于概念",
      "from": "Algorithm",
      "to": "Concept",
      "direction": "OUTGOING"
    },
    {
      "name": "SOLVED_BY",
      "label": "由...解决",
      "description": "题目由方法解决",
      "from": "Question",
      "to": "Method",
      "direction": "OUTGOING",
      "properties": {
        "efficiency": {
          "type": "String",
          "enum": ["优", "良", "中", "差"],
          "description": "效率评价"
        }
      }
    },
    {
      "name": "COVERS",
      "label": "覆盖",
      "description": "文献覆盖知识点",
      "from": "Reference",
      "to": "KnowledgePoint",
      "direction": "OUTGOING"
    },
    {
      "name": "SIMILAR_TO",
      "label": "相似于",
      "description": "题目相似关系",
      "from": "Question",
      "to": "Question",
      "direction": "OUTGOING",
      "properties": {
        "similarity": {
          "type": "Float",
          "range": [0, 1],
          "description": "相似度"
        },
        "reason": {
          "type": "String",
          "description": "相似原因"
        }
      }
    },
    {
      "name": "RECOMMENDED_FOR",
      "label": "推荐用于",
      "description": "知识点推荐用于学习某知识点",
      "from": "KnowledgePoint",
      "to": "KnowledgePoint",
      "direction": "OUTGOING"
    },
    {
      "name": "HAS_TYPE",
      "label": "有题型",
      "description": "题目有特定题型",
      "from": "Question",
      "to": "ProblemType",
      "direction": "OUTGOING",
      "unique": true
    },
    {
      "name": "RELATED_TO",
      "label": "相关于",
      "description": "算法与数据结构相关",
      "from": "Algorithm",
      "to": "DataStructure",
      "direction": "OUTGOING",
      "properties": {
        "description": {
          "type": "String",
          "description": "相关描述"
        }
      }
    },
    {
      "name": "HAS_CONCEPT",
      "label": "有概念",
      "description": "知识点包含概念",
      "from": "KnowledgePoint",
      "to": "Concept",
      "direction": "OUTGOING"
    },
    {
      "name": "PRACTICE_IMPROVES",
      "label": "练习提升",
      "description": "练习题目提升知识点掌握",
      "from": "Question",
      "to": "KnowledgePoint",
      "direction": "OUTGOING",
      "properties": {
        "improvement_score": {
          "type": "Float",
          "range": [0, 1],
          "description": "提升分数"
        }
      }
    }
  ],
  "constraints": [
    {
      "type": "UNIQUE",
      "entity": "Question",
      "property": "id",
      "description": "题目ID必须唯一"
    },
    {
      "type": "UNIQUE",
      "entity": "KnowledgePoint",
      "property": "name",
      "description": "知识点名称必须唯一"
    },
    {
      "type": "UNIQUE",
      "entity": "Algorithm",
      "property": "name",
      "description": "算法名称必须唯一"
    },
    {
      "type": "UNIQUE",
      "entity": "DataStructure",
      "property": "name",
      "description": "数据结构名称必须唯一"
    },
    {
      "type": "NOT_NULL",
      "entity": "Question",
      "property": "name",
      "description": "题目名称不能为空"
    },
    {
      "type": "NOT_NULL",
      "entity": "KnowledgePoint",
      "property": "name",
      "description": "知识点名称不能为空"
    },
    {
      "type": "RANGE",
      "entity": "KnowledgePoint",
      "property": "importance",
      "range": [0, 1],
      "description": "重要程度必须在0-1之间"
    },
    {
      "type": "RANGE",
      "entity": "Question",
      "property": "pass_rate",
      "range": [0, 1],
      "description": "通过率必须在0-1之间"
    }
  ],
