        {
          "name": "space_complexity",
          "type": "String",
          "required": false,
          "description": "空间复杂度"
        },
        {
          "name": "difficulty",
          "type": "String",
          "required": false,
          "enum": ["简单", "中等", "困难", "极难"],
          "description": "数据结构难度"
        }
      ]
    },
