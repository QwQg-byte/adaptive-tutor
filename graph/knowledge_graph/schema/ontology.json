  "relationships": [
    {
      "name": "BELONGS_TO",
      "label": "属于",
      "description": "题目属于某分类",
      "from": "Question",
      "to": "Category",
      "direction": "OUTGOING",
      "unique": true
    },
    {
      "name": "HAS_DIFFICULTY",
      "label": "有难度",
      "description": "题目有难度级别",
      "from": "Question",
      "to": "Difficulty",
      "direction": "OUTGOING",
      "unique": true
    },
    {
      "name": "REQUIRES",
      "label": "需要",
      "description": "题目需要知识点",
      "from": "Question",
      "to": "KnowledgePoint",
      "direction": "OUTGOING",
      "properties": {
        "weight": {
          "type": "Float",
          "range": [0, 1],
          "description": "权重"
        }
      }
    },
    {
      "name": "USES_ALGORITHM",
      "label": "使用算法",
      "description": "题目使用算法",
      "from": "Question",
      "to": "Algorithm",
      "direction": "OUTGOING",
      "properties": {
        "importance": {
          "type": "String",
          "enum": ["主要", "次要", "辅助"],
          "description": "重要程度"
        }
      }
    },
    {
      "name": "USES_STRUCTURE",
      "label": "使用数据结构",
      "description": "题目使用数据结构",
      "from": "Question",
      "to": "DataStructure",
      "direction": "OUTGOING",
      "properties": {
        "importance": {
          "type": "String",
          "enum": ["主要", "次要", "辅助"],
          "description": "重要程度"
        }
      }
    },
